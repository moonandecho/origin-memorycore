# mnemosyne cold-tier engine — environment
# Copy to /etc/mnemosyne/engine.env (or anywhere the unit's EnvironmentFile points at) and edit.
#
# Values below are the ones we run in production. Every knob can be overridden here; the
# entry point only supplies defaults.

# --- storage ---
MNEMOSYNE_DATA_DIR=/var/lib/mnemosyne

# --- embeddings (any OpenAI-compatible endpoint; ollama works) ---
MNEMOSYNE_EMBEDDING_API_URL=http://127.0.0.1:11434/v1
MNEMOSYNE_EMBEDDING_MODEL=qwen3-embedding:0.6b
MNEMOSYNE_EMBEDDING_API_KEY=dummy
MNEMOSYNE_VEC_TYPE=float32

# --- http ---
MNEMOSYNE_HOST=127.0.0.1
MNEMOSYNE_PORT=8936
# comma-separated Host headers accepted by the streamable-http transport
MNEMOSYNE_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*

# --- recall ranking (see patches/README.md for what 0002 changes) ---
MNEMOSYNE_RECENCY_HALFLIFE=8760
MNEMOSYNE_VEC_WEIGHT=0.7
MNEMOSYNE_FTS_WEIGHT=0.2
MNEMOSYNE_IMPORTANCE_WEIGHT=0.1

# --- engine rework switches (from patches/0002) ---
# new core schema: vector_store table + dual-path read (needs a migrated database)
MNEMOSYNE_CORE_SCHEMA=on
# recall narrows to the caller's domain instead of treating scope='global' as a
# cross-domain skeleton key
MNEMOSYNE_DOMAIN_NARROW=1
