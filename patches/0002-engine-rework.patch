+"""L3b policy extension point (skeleton + resolver).
+
+This module is deliberately dependency-free: it imports only the Python
+standard library, never MemoryCore, never a database, and performs no
+network or embedding calls.  It is the single place that understands the
+``MNEMOSYNE_POLICY_INJECTION`` switch whitelist.
+
+Design contract (see ``c2/l3b/EXTENSION-POINT-SPEC.md``):
+
+* switch off  -> legacy current value (the ``default`` / optional
+  ``legacy_env`` argument) is returned; the provider is never touched;
+* switch on   -> an installed :class:`PolicyProvider` is consulted;
+* missing provider / provider exception / unknown key / wrong type /
+  NaN / Inf / out-of-range value -> the field's current default is
+  returned and one observable fallback warning is recorded and logged;
+* the resolver never raises provider failures into a recall, sleep,
+  maintenance or sync call path;
+* values are not clamped: an invalid field falls back whole-field.
+"""
+
+from __future__ import annotations
+
+import logging
+import math
+import os
+import threading
+from dataclasses import asdict, dataclass, fields, replace
+from typing import (
+    Any,
+    Callable,
+    Dict,
+    Iterable,
+    List,
+    Mapping,
+    Optional,
+    Protocol,
+    Tuple,
+    runtime_checkable,
+)
+
+logger = logging.getLogger(__name__)
+
+POLICY_INJECTION_ENV = "MNEMOSYNE_POLICY_INJECTION"
+_TRUE_VALUES = frozenset({"1", "true", "yes", "on"})
+_SCHEMA_VERSION = 1
+_MAX_RECORDED_WARNINGS = 200
+
+
+class PolicyError(ValueError):
+    """Control-plane declaration; never raised from a hot-path resolve."""
+
+
+class IdentityPolicyProvider:
+    """Convenience provider whose answer is exactly current value.
+
+    Accepting ``default`` for every key makes this the explicit "no policy
+    change" implementation used by H2 identity checks.
+    """
+
+    def get(self, key: str, default: Any) -> Any:
+        return default
+
+
+@runtime_checkable
+class PolicyProvider(Protocol):
+    """A provider only has to implement ``get(key, default)``."""
+
+    def get(self, key: str, default: Any) -> Any:
+        ...
+
+
+# ---------------------------------------------------------------------------
+# Typed policy views.  Every default is byte-for-byte the current c2/tree
+# value; these dataclasses are contracts for future wiring, not behaviour.
+# ---------------------------------------------------------------------------
+@dataclass(frozen=True)
+class ScoringFormula:
+    relevance_mix_lexical: float = 0.75
+    relevance_mix_normalized: float = 0.25
+    wm_keyword_share: float = 0.6
+    wm_recency_share: float = 0.4
+    wm_relevance_square: float = 0.08
+    episodic_admit_similarity: float = 0.65
+    graph_bonus_per_edge: float = 0.02
+    graph_bonus_cap: float = 0.08
+    binary_bonus_cap: float = 0.08
+
+
+@dataclass(frozen=True)
+class RecallPolicy:
+    schema_version: int = 1
+    candidate_pool_multiplier: float = 4.0
+    min_candidate_pool: int = 300
+    hard_candidate_cap: Optional[int] = None
+    lex_gate_short: float = 0.15
+    lex_gate_mid: float = 0.5
+    lex_gate_long: float = 0.3
+    lex_gate_scale: float = 1.0
