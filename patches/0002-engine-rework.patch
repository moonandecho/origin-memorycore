+
+# ---------------------------------------------------------------------------
+# Global control plane.  ``install_policy_provider`` is only for startup and
+# tests; the hot-path resolver never mutates this state.
+# ---------------------------------------------------------------------------
+_provider: Optional[PolicyProvider] = None
+_warnings: List[Dict[str, Any]] = []
+_lock = threading.Lock()
+
+
+def install_policy_provider(provider: Optional[PolicyProvider]) -> None:
+    """Install (or clear, with ``None``) the process-wide provider."""
+    global _provider
+    if provider is not None and not callable(getattr(provider, "get", None)):
+        raise PolicyError("policy provider must implement get(key, default)")
+    with _lock:
+        _provider = provider
+
+
+def get_policy_provider() -> Optional[PolicyProvider]:
+    with _lock:
+        return _provider
+
+
+def reset_policy_state() -> None:
+    """Test/control-plane helper: clear the provider and warning records."""
+    global _provider, _warnings
+    with _lock:
+        _provider = None
+        _warnings = []
+
+
+def policy_injection_enabled(raw: Any = None) -> bool:
+    """Return True only for ``1``/``true``/``yes``/``on``.
+
+    ``raw is None`` reads the process environment.  Parsing is strip +
+    case-insensitive; every other value (including ``None``, empty,
+    ``off``, ``2``, garbage) is off.
+    """
+
+    if raw is None:
+        raw = os.environ.get(POLICY_INJECTION_ENV)
+    if raw is None:
+        return False
+    return str(raw).strip().lower() in _TRUE_VALUES
+
+
+def get_policy_warnings() -> List[Dict[str, Any]]:
+    """Return a copy of the observable, content-free fallback records."""
+    with _lock:
+        return [dict(item) for item in _warnings]
+
+
+def reset_policy_warnings() -> None:
+    global _warnings
+    with _lock:
+        _warnings = []
+
+
+def _record_fallback(key: str, reason: str, default: Any) -> None:
+    with _lock:
+        if len(_warnings) < _MAX_RECORDED_WARNINGS:
+            _warnings.append(
+                {
+                    "key": str(key),
+                    "reason": str(reason),
+                    "schema_version": _SCHEMA_VERSION,
+                    "default_type": type(default).__name__,
+                }
+            )
+    logger.warning("PolicyFallback key=%s reason=%s (using current default)", key, reason)
+
+
+def _legacy_value(
+    default: Any,
+    legacy_env: Optional[str],
+    legacy_parser: Optional[Callable[[str], Any]] = None,
+) -> Any:
+    """Best-effort legacy env compatibility for callers that need it.
+
+    This is the single legacy-env parser used by :func:`resolve_value`.  When
+    ``legacy_parser`` is given it receives the raw environment string, which
+    lets a wiring point preserve bespoke legacy behaviour (for example the
+    clamp / floor logic of the sleep model-refresh thresholds).  On any
+    parsing problem the hardcoded ``default`` is returned; the resolver never
+    raises an environment parsing error into a call path.
+    """
+
+    if not legacy_env:
+        return default
+    raw = os.environ.get(legacy_env)
+    if raw is None:
+        return default
+    if legacy_parser is not None:
+        try:
+            return legacy_parser(raw)
+        except Exception:  # noqa: BLE001 - fail closed to current default
+            return default
+    text = str(raw).strip()
+    if isinstance(default, bool):
+        lowered = text.lower()
+        if lowered in _TRUE_VALUES:
+            return True
+        if lowered in {"0", "false", "no", "off"}:
+            return False
+        return default
+    if isinstance(default, int) and not isinstance(default, bool):
+        try:
+            return int(text)
+        except (TypeError, ValueError):
+            return default
+    if isinstance(default, float):
+        try:
+            value = float(text)
+        except (TypeError, ValueError):
+            return default
+        if math.isfinite(value):
+            return value
+        return default
+    if isinstance(default, str):
+        return text
+    return default
+
+
+def _check_value(
+    value: Any,
+    default: Any,
+    minimum: Optional[float],
+    maximum: Optional[float],
+    allowed: Optional[Iterable[Any]],
+) -> Tuple[bool, str, Any]:
+    """Return (ok, reason, normalized_value) for a provider answer."""
+
+    if value is None:
+        return False, "unknown_or_none", default
+
+    if isinstance(default, bool):
+        if not isinstance(value, bool):
+            return False, "bad_type", default
+        normalized: Any = value
+    elif isinstance(default, int) and not isinstance(default, bool):
+        if isinstance(value, bool) or not isinstance(value, int):
+            return False, "bad_type", default
+        normalized = value
+    elif isinstance(default, float):
+        if isinstance(value, bool) or not isinstance(value, (int, float)):
+            return False, "bad_type", default
+        normalized = float(value)
+        if not math.isfinite(normalized):
+            return False, "bad_value", default
+    elif isinstance(default, str):
+        if not isinstance(value, str):
+            return False, "bad_type", default
+        normalized = value
+    elif default is None:
+        if not isinstance(value, (str, int, float, bool, list, dict)):
+            return False, "bad_type", default
+        if isinstance(value, float) and not math.isfinite(value):
+            return False, "bad_value", default
+        normalized = value
+    else:
+        if not isinstance(value, type(default)):
+            return False, "bad_type", default
+        normalized = value
+
+    if allowed is not None:
+        allowed_tuple = tuple(allowed)
+        if normalized not in allowed_tuple:
+            return False, "bad_choice", default
+
+    bound = normalized
+    if not isinstance(bound, (int, float)) or isinstance(bound, bool):
+        bound = None
+    if bound is not None and (minimum is not None or maximum is not None):
+        if minimum is not None and bound < minimum:
+            return False, "out_of_range", default
+        if maximum is not None and bound > maximum:
+            return False, "out_of_range", default
+    return True, "ok", normalized
+
+
+def resolve_value(
+    key: str,
+    default: Any,
+    legacy_env: Optional[str] = None,
+    *,
+    minimum: Optional[float] = None,
+    maximum: Optional[float] = None,
+    allowed: Optional[Iterable[Any]] = None,
+    legacy_parser: Optional[Callable[[str], Any]] = None,
+) -> Any:
+    """Hot-path entry point for one policy value.
+
+    Precedence is **legacy env > injected provider > hardcoded default**.
+    The legacy environment is read first, independently of the switch, so a
+    user's existing ``MNEMOSYNE_*`` deployment keeps priority after wiring.
+
+    With no legacy env and the switch off, the current default is returned
+    and the provider is never touched.  With the switch on, the installed
+    provider is consulted; *any* missing provider, exception, unknown key,
+    wrong type, NaN/Inf or out-of-range answer falls back whole-field to
+    ``default`` and records one observable ``PolicyFallback`` warning.
+    Provider failures never escape.
+    """
+
+    if legacy_env and os.environ.get(legacy_env) is not None:
+        return _legacy_value(default, legacy_env, legacy_parser)
+
+    if not policy_injection_enabled():
+        return default
+
+    provider = get_policy_provider()
+    if provider is None:
+        _record_fallback(key, "provider_missing", default)
+        return default
+
+    try:
+        candidate = provider.get(key, default)
+    except Exception as exc:  # noqa: BLE001 - deliberately fail closed
+        _record_fallback(key, "provider_failed:" + type(exc).__name__, default)
+        return default
+
+    if candidate is None:
+        _record_fallback(key, "unknown_or_none", default)
+        return default
+
+    ok, reason, normalized = _check_value(candidate, default, minimum, maximum, allowed)
+    if not ok:
+        _record_fallback(key, reason, default)
+        return default
+    return normalized
+
+
+# ---------------------------------------------------------------------------
+# Optional typed-bundle validation helper (used by F-POL-03 style tests and
+# by future MemoryCore control-plane loaders).  It does not write anything.
+# ---------------------------------------------------------------------------
+_FIELD_RULES: Dict[str, Tuple[str, Tuple[float, float]]] = {
+    "candidate_pool_multiplier": ("float", (1.0, 16.0)),
+    "min_candidate_pool": ("int", (0, 10000)),
+    "lex_gate_short": ("float", (0.0, 1.0)),
+    "lex_gate_mid": ("float", (0.0, 1.0)),
+    "lex_gate_long": ("float", (0.0, 1.0)),
+    "lex_gate_scale": ("float", (0.0, 10.0)),
+    "vec_admit_min": ("float", (0.0, 1.0)),
+    "vec_score_weight": ("float", (0.0, 1.0)),
+    "vec_weight": ("float", (0.0, 1.0)),
+    "fts_weight": ("float", (0.0, 1.0)),
+    "importance_weight": ("float", (0.0, 1.0)),
+    "temporal_weight": ("float", (0.0, 1.0)),
+    "temporal_halflife_hours": ("float", (0.1, 8760.0)),
+    "resolve_similarity_threshold": ("float", (0.0, 1.0)),
+    "heuristic_min_hours_diff": ("float", (0.0, 8760.0)),
+    "min_overlapping_tokens": ("int", (0, 100)),
+    "duplicate_edit_distance_max": ("float", (0.0, 1.0)),
+    "confidence_floor": ("float", (0.0, 1.0)),
+    "judge_timeout_seconds": ("float", (0.1, 120.0)),
+    "judge_max_tokens": ("int", (1, 32768)),
+    "judge_temperature": ("float", (0.0, 2.0)),
+    "judge_max_retries": ("int", (0, 10)),
+    "judge_initial_delay_seconds": ("float", (0.0, 60.0)),
+    "judge_backoff_factor": ("float", (1.0, 10.0)),
+    "working_memory_max_items": ("int", (0, 10_000_000)),
+    "working_memory_ttl_hours": ("int", (1, 87600)),
+    "wm_bump_cap_hours": ("int", (0, 8760)),
+    "episodic_recall_limit": ("int", (0, 10_000_000)),
+    "scratchpad_max_items": ("int", (0, 10_000_000)),
+    "sleep_batch_size": ("int", (1, 1_000_000)),
+    "tier2_days": ("int", (0, 36500)),
+    "tier3_days": ("int", (0, 36500)),
+    "degrade_batch_size": ("int", (1, 1_000_000)),
+    "conflict_window_seconds": ("float", (0.0, 86400.0)),
+    "max_future_skew_seconds": ("int", (0, 86400)),
+    "max_response_bytes": ("int", (1, 2**40)),
+    "pull_limit": ("int", (1, 1_000_000)),
+    "max_tokens": ("int", (1, 32768)),
+    "auto_apply_min_confidence": ("float", (0.0, 1.0)),
+    "auto_apply_min_evidence": ("int", (1, 10000)),
+    "auto_apply_conflict_min_confidence": ("float", (0.0, 1.0)),
+    "auto_apply_conflict_min_evidence": ("int", (1, 10000)),
+    "batch_size": ("int", (1, 1_000_000)),
+    "max_iterations": ("int", (1, 1000)),
+    "similarity_threshold": ("float", (0.0, 1.0)),
+    "harmony_threshold": ("float", (0.0, 1.0)),
+    "min_cluster_size": ("int", (1, 10000)),
+    "temperature": ("float", (0.0, 2.0)),
+}
+
+
+def validated_bundle(overrides: Mapping[str, Any]) -> Tuple[PolicyBundle, List[str]]:
+    """Validate flat overrides and return ``(bundle, warnings)``.
+
+    All flat policy sections are covered.  Invalid whole field ->
+    that field keeps its current default (no clamp/partial application).
+    """
+
+    warnings: List[str] = []
+    bundle = PolicyBundle()
+    sections = {
+        "recall": RecallPolicy,
+        "conflict": ConflictPolicy,
+        "retention": RetentionPolicy,
+        "sync": SyncPolicy,
+        "llm": LLMPolicy,
+        "model_refresh": ModelRefreshPolicy,
+        "shmr": ShmrPolicy,
+    }
+    for section, cls in sections.items():
+        current = getattr(bundle, section)
+        values: Dict[str, Any] = {
+            field.name: getattr(current, field.name)
+            for field in fields(current)
+            if field.name not in {"schema_version", "formula"}
+        }
+        for key, raw in overrides.items():
+            if key not in values or key not in _FIELD_RULES:
+                continue
+            typ, (low, high) = _FIELD_RULES[key]
+            try:
+                value = float(raw) if typ == "float" else int(raw)
+            except (TypeError, ValueError):
+                warnings.append(f"{section}.{key}:bad_type -> default")
+                continue
+            if typ == "float" and not math.isfinite(value):
+                warnings.append(f"{section}.{key}:bad_value({raw!r}) -> default")
+                continue
+            if value < low or value > high:
+                warnings.append(f"{section}.{key}:out_of_range({raw!r}) -> default")
+                continue
+            values[key] = value
+        bundle = replace(bundle, **{section: replace(current, **values)})
+    return bundle, warnings
+
+
+def bundle_to_dict(bundle: PolicyBundle) -> Dict[str, Any]:
+    """Canonical-ish diagnostic representation used by tests/docs."""
+    return asdict(bundle)
+
+
+__all__ = [
+    "ConflictPolicy",
+    "POLICY_INJECTION_ENV",
+    "PolicyBundle",
+    "IdentityPolicyProvider",
+    "LLMPolicy",
+    "ModelRefreshPolicy",
+    "PolicyError",
+    "PolicyProvider",
+    "RecallPolicy",
+    "RetentionPolicy",
+    "ScoringFormula",
+    "ShmrPolicy",
+    "SyncPolicy",
+    "bundle_to_dict",
+    "get_policy_provider",
+    "get_policy_warnings",
+    "install_policy_provider",
+    "policy_injection_enabled",
+    "reset_policy_state",
+    "reset_policy_warnings",
+    "resolve_value",
+    "validated_bundle",
+]
