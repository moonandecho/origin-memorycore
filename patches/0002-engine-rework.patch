+# Read path
+# ---------------------------------------------------------------------------
+
+_DEFAULT_COST_THRESHOLD = 300000
+_NUMPY_SENTINEL = object()
+_NUMPY = _NUMPY_SENTINEL
+
+
+def _cost_threshold() -> int:
+    """Return the visible cost threshold for one vector candidate fetch.
+
+    The legacy env var name is retained for operators, but its role is now a
+    guard threshold: it does not define the candidate set.  Candidate rows in
+    the current scope are all evaluated while their count is <= this value;
+    beyond it the fetch is explicitly truncated and the r17 guard fires.
+    """
+    raw = os.environ.get("MNEMOSYNE_CORE_VECTOR_SCAN_LIMIT", "")
+    if not str(raw).strip():
+        return _DEFAULT_COST_THRESHOLD
+    try:
+        return max(0, int(str(raw).strip()))
+    except (TypeError, ValueError):
+        return _DEFAULT_COST_THRESHOLD
+
+
+def _get_numpy():
+    """Lazy optional numpy for chunked exact-cosine scoring.
+
+    numpy is only an accelerator: the scoring formula and selection order are
+    unchanged, and a pure-stdlib fallback remains available when numpy is not
+    installed.
+    """
+    global _NUMPY
+    if _NUMPY is _NUMPY_SENTINEL:
+        try:
+            import numpy as _np
+            _NUMPY = _np
+        except Exception:
+            _NUMPY = None
+    return _NUMPY
+
+
+def _score_chunk(rows, query_unit, *, allow_numpy: bool = True):
+    """Return exact-cosine (sim, rowid, entity_id) candidates for a row chunk.
+
+    The returned list is sorted by the recall sort key ``(-sim, rowid)`` and
+    contains at most the caller-requested k entries (the caller slices).  The
+    math mirrors ``cosine_similarity``: stored vectors are normalised, then
+    dotted with the unit query.  numpy is used only as a vectorised
+    implementation of that same formula.
+    """
+    np = _get_numpy() if allow_numpy else None
+    q_len = len(query_unit)
+    if np is not None:
+        try:
+            mat = np.empty((len(rows), q_len), dtype=np.float32)
+            valid = []
+            rowids = []
+            ids = []
+            for i, row in enumerate(rows):
+                raw = row[2]
+                vals = None
+                if isinstance(raw, (bytes, bytearray, memoryview)):
+                    b = raw.tobytes() if isinstance(raw, memoryview) else bytes(raw)
+                    if len(b) == q_len * 4:
+                        try:
+                            vals = np.frombuffer(b, dtype="<f4")
+                        except Exception:
+                            vals = None
+                if vals is None:
+                    vals = blob_to_floats(raw)
+                    if len(vals) != q_len:
+                        continue
+                elif vals.size != q_len:
+                    continue
+                mat[i] = vals
+                valid.append(i)
+                rowids.append(int(row[1]))
+                ids.append(row[0])
+            if not valid:
+                return []
+            sub = mat[valid]
+            norms = np.linalg.norm(sub, axis=1)
+            keep = norms > 0.0
+            if not bool(keep.any()):
+                return []
+            sub = sub[keep]
+            rowids_arr = np.asarray(rowids, dtype=np.int64)[keep]
+            ids = [ids[i] for i in np.nonzero(keep)[0].tolist()]
+            q = np.asarray(query_unit, dtype=np.float32)
+            sims = (sub @ q) / np.linalg.norm(sub, axis=1)
+            order = np.lexsort((rowids_arr, -sims))
+            out = []
+            for idx in order.tolist():
+                out.append((float(sims[idx]), int(rowids_arr[idx]), ids[idx]))
+            return out
+        except Exception:
+            logger.debug("numpy chunk scoring failed; using stdlib fallback", exc_info=True)
+    # stdlib fallback (same formula as the original read path)
+    out = []
+    for row in rows:
+        try:
+            entity_id = row[0]
+            entity_rowid = int(row[1])
+            raw = row[2]
+        except Exception:
+            continue
+        sim = cosine_similarity(query_unit, raw)
+        if sim is None:
+            continue
+        out.append((float(sim), entity_rowid, entity_id))
+    out.sort(key=lambda item: (-item[0], item[1]))
+    return out
+
+
+_AMBIGUOUS_WHERE_COLS = {
+    "working": ("id", "author_id", "author_type", "channel_id", "created_at"),
+    "episodic": ("id", "author_id", "author_type", "channel_id", "created_at"),
+}
+
+
+def _qualify_where_sql(where_sql: Optional[str], owner_kind: str) -> Optional[str]:
+    """Qualify content-table columns that also exist in ``vector_store``.
+
+    Recall builds ``where_sql`` in content-table terms (for example
+    ``author_id = ?``).  Joining ``working_memory wm`` with ``vector_store vs``
+    makes unqualified ``author_id``/``channel_id``/``created_at`` ambiguous, so
+    SQLite raises and the old read helper swallowed the error.  Qualifying the
+    content-table side here keeps the candidate scope exactly the caller's
+    recall filters instead of silently returning no vector candidates.
+    """
+    if not where_sql:
+        return where_sql
+    alias = {"working": "wm", "episodic": "em"}.get(str(owner_kind or "").lower())
+    if not alias:
+        return where_sql
+    sql = where_sql
+    for col in _AMBIGUOUS_WHERE_COLS.get(str(owner_kind or "").lower(), ()):
+        sql = re.sub(rf"(?<![\w.]){re.escape(col)}\b", f"{alias}.{col}", sql)
+    return sql
+
+
+def _filter_top_by_where(conn, joins, id_expr, top, where_sql, where_params):
+    """Restrict a globally-scored candidate face to the caller's filters.
+
+    The old arm's sqlite-vec query computes a global KNN top-k first and applies
+    the caller's additional predicates afterwards.  This helper reproduces that
+    ordering for the exact-KNN core path: score the global scope, then keep only
+    the top candidates that satisfy ``where_sql``.  It returns candidates in
+    the same order they arrived (already sorted by ``(-sim, rowid)``).
+    """
+    if not top or not where_sql:
+        return top
+    ids = [str(item[2]) for item in top]
+    placeholders = ",".join("?" * len(ids))
+    sql = (
+        f"SELECT {id_expr} AS entity_id "
+        f"{joins}"
+        f"WHERE {id_expr} IN ({placeholders}) AND ({where_sql})"
+    )
+    params = list(ids) + list(where_params or ())
+    try:
+        rows = conn.execute(sql, tuple(params)).fetchall()
+    except sqlite3.Error:
+        logger.debug("candidate post-filter failed; returning no candidates", exc_info=True)
+        return []
+    keep = {str(r[0]) for r in rows}
+    return [item for item in top if str(item[2]) in keep]
+
+
+def _scope_row_count(conn, owner_kind, where_sql, where_params):
+    """Exact count of scoreable rows in the current scope (guard-only probe)."""
+    try:
+        joins, _ = _owner_select(owner_kind)
+    except ValueError:
+        return 0
+    clauses = [
+        "vs.owner_kind = ?",
+        "vs.state = 'active'",
+        "vs.vec_type = 'float32'",
+    ]
+    params = [str(owner_kind)]
+    where_sql = _qualify_where_sql(where_sql, owner_kind)
+    if where_sql:
+        clauses.append(f"({where_sql})")
+        params.extend(list(where_params or ()))
+    sql = f"SELECT COUNT(*) {joins} WHERE " + " AND ".join(clauses)
+    try:
+        row = conn.execute(sql, tuple(params)).fetchone()
+        return int(row[0]) if row is not None else 0
+    except sqlite3.Error:
+        return 0
+
+
+def _record_vec_scope_guard(*, scope, scope_rows, threshold, excluded_rows):
+    """Read-only guard: counters + one explicit warning line."""
+    try:
+        from mnemosyne.core import recall_counters
+        recall_counters.record_vec_scope_truncation(
+            scope=scope,
+            scope_rows=int(scope_rows),
+            threshold=int(threshold),
+            excluded_rows=max(0, int(excluded_rows)),
+        )
+    except Exception:
+        logger.debug("vec scope counter update failed (non-fatal)", exc_info=True)
+    logger.warning(
+        "vec_scope_truncated scope=%s scope_rows=%s threshold=%s excluded_rows=%s; "
+        "触发离线评估 (trigger offline evaluation)",
+        scope, scope_rows, threshold, excluded_rows,
+    )
+
+
+def _owner_select(owner_kind: str) -> Tuple[str, str]:
+    """Return (FROM/JOIN clause, entity rowid expression)."""
+    kind = str(owner_kind or "").lower()
+    if kind == "working":
+        return (
+            "FROM vector_store vs "
+            "JOIN working_memory wm ON wm.id = vs.owner_id "
+            "AND vs.owner_rowid IS NOT NULL AND vs.owner_rowid = wm.rowid ",
+            "wm.rowid",
+        )
+    if kind == "episodic":
+        return (
+            "FROM vector_store vs "
+            "JOIN episodic_memory em ON em.id = vs.owner_id "
+            "AND vs.owner_rowid IS NOT NULL AND vs.owner_rowid = em.rowid ",
+            "em.rowid",
+        )
+    if kind == "fact":
+        return (
+            "FROM vector_store vs "
+            "JOIN facts f ON f.fact_id = vs.owner_id "
+            "AND vs.owner_rowid IS NOT NULL AND vs.owner_rowid = f.rowid ",
+            "f.rowid",
+        )
+    if kind == "triple":
+        return (
+            "FROM vector_store vs "
+            "JOIN triples t ON CAST(t.id AS TEXT) = vs.owner_id "
+            "AND vs.owner_rowid IS NOT NULL AND vs.owner_rowid = t.rowid ",
+            "t.rowid",
+        )
+    if kind == "canonical":
+        return (
+            "FROM vector_store vs "
+            "JOIN canonical_facts c ON CAST(c.id AS TEXT) = vs.owner_id "
+            "AND vs.owner_rowid IS NOT NULL AND vs.owner_rowid = c.rowid ",
+            "c.rowid",
+        )
+    raise ValueError(f"unsupported owner_kind: {owner_kind!r}")
+
+
+def search_vector_store(
+    conn: sqlite3.Connection,
+    query: Any,
+    *,
+    owner_kind: str = "working",
+    k: int = 20,
+    where_sql: Optional[str] = None,
+    where_params: Sequence[Any] = (),
+    id_expr: Optional[str] = None,
+    limit: Optional[int] = None,
+    query_is_unit: bool = False,
+    cap: Optional[int] = None,
+    cap_order_by: Optional[str] = None,
+    stats_out: Optional[Dict[str, Any]] = None,
+    scope_label: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Exact KNN over one owner kind in ``vector_store``.
+
+    Candidate-pool contract (r17): **candidate pool = the old arm's global KNN
+    restricted to the current scope**.  The scope is the caller's narrowed
+    domain (when domain narrowing is on) or the full store (when it is off).
+    For narrowing off, the exact-KNN scan scores the full store; the caller's
+    additional ``where_sql`` filters are applied *after* global scoring,
+    reproducing sqlite-vec's MATCH-then-WHERE ordering.  The legacy 50,000-row
+    natural-order window no longer defines the candidate set.
+
+    ``MNEMOSYNE_CORE_VECTOR_SCAN_LIMIT`` is a *cost threshold* / guard, not a
+    functional truncation window.  If the scope has more scoreable rows than
+    the threshold, the fetch is explicitly truncated to the threshold and the
+    r17 guard records ``vec_scope_truncated`` / ``vec_scope_excluded_rows`` and
+    emits one warning line containing "触发离线评估".  Guard signalling never
+    changes the returned rows beyond the guarded truncation itself.
+
+    ``stats_out`` (r14, read-only counters): optional dict filled with
+    ``{"fetched": <candidate rows delivered>}``.  ``scope_label`` is an
+    optional human-readable scope identifier for the r17 guard log.
+    """
+    if not vector_store_available(conn):
+        return []
+    if query_is_unit:
+        q_unit = blob_to_floats(query)
+        if not q_unit:
+            return []
+    else:
+        q_unit = normalize_floats(query)
+        if not q_unit:
+            return []
+    try:
+        joins, rowid_expr = _owner_select(owner_kind)
+    except ValueError:
+        return []
+    if id_expr is None:
+        if owner_kind == "working":
+            id_expr = "wm.id"
+        elif owner_kind == "episodic":
+            id_expr = "em.id"
+        elif owner_kind == "fact":
+            id_expr = "f.fact_id"
+        elif owner_kind == "triple":
+            id_expr = "CAST(t.id AS TEXT)"
+        else:
+            id_expr = "CAST(c.id AS TEXT)"
+
+    threshold = _cost_threshold()
+    where_sql = _qualify_where_sql(where_sql, owner_kind)
+    explicit_cap = None if limit is None else max(0, int(limit))
+    if cap is not None and cap_order_by and owner_kind == "working":
+        # r11 form4 domain-cap path: the inner derived table already limits
+        # the scoreable face to DOMAIN_CAP (10,000), well below the r17 cost
+        # threshold.  It still evaluates every row in that capped face.
+        idx = _owner_rowid_index(conn, "vector_store")
+        indexed_by = f" INDEXED BY {idx}" if idx else ""
+        sql = (
+            f"SELECT {id_expr} AS entity_id, wm.rowid AS entity_rowid, "
+            f"vs.vector AS vector "
+            f"FROM (SELECT id, rowid FROM working_memory "
+            f"      WHERE {where_sql or '1=1'} "
+            f"      ORDER BY {cap_order_by} "
+            f"      LIMIT ?) wm "
+            f"CROSS JOIN vector_store AS vs{indexed_by} "
+            f"  ON vs.owner_kind = 'working' AND vs.owner_rowid = wm.rowid "
+            f"WHERE vs.state = 'active' AND vs.vec_type = 'float32' "
+            f"LIMIT ?"
+        )
+        params = list(where_params or ()) + [int(cap), int(cap) + 1]
+        effective_cap = None
+    else:
+        # r17: the candidate face is the old arm's *global* KNN restricted to
+        # the current scope.  The scope is the owner store (narrowing off) or
+        # the capped domain (narrowing on, handled by the cap branch above);
+        # the caller's additional filters are applied after global scoring by
+        # _filter_top_by_where, exactly like sqlite-vec's MATCH-then-WHERE
+        # ordering.  Do not put where_sql into this SQL: doing so would turn
+        # the candidate face into a local top-k and reintroduce M2-style drift.
+        clauses = [
+            "vs.owner_kind = ?",
+            "vs.state = 'active'",
+            "vs.vec_type = 'float32'",
+        ]
+        params = [str(owner_kind)]
+        effective_cap = threshold if explicit_cap is None else min(explicit_cap, threshold)
+        sql = (
+            f"SELECT {id_expr} AS entity_id, {rowid_expr} AS entity_rowid, "
+            f"vs.vector AS vector "
+            f"{joins}"
+            f"WHERE " + " AND ".join(clauses) + " LIMIT ?"
+        )
+        # Fetch one sentinel row beyond the cap so truncation is observed,
+        # never assumed.
+        params.append(int(effective_cap) + 1)
+
+    top: List[Tuple[float, int, Any]] = []
+    total = 0
+    truncated = False
+    # Preserve the legacy pure-Python scoring path for the <=50,000-row
+    # scopes that the old arm's exact-KNN window could cover; use the numpy
+    # accelerator only when the scope genuinely needs the wider r17 scan.
+    allow_numpy = effective_cap is not None and int(effective_cap) > 50000
+    try:
+        cur = conn.cursor()
+        cur.execute(sql, tuple(params))
+        while True:
+            rows = cur.fetchmany(4096)
+            if not rows:
+                break
+            if effective_cap is not None:
+                remaining = int(effective_cap) - total
+                if remaining < 0:
+                    remaining = 0
+                if len(rows) > remaining:
+                    truncated = True
+                    rows = rows[:remaining]
+                if not rows:
+                    break
+            total += len(rows)
+            chunk = _score_chunk(rows, q_unit, allow_numpy=allow_numpy)
+            if not chunk:
+                continue
+            top.extend(chunk)
+            # Keep only the global top-k shape; a chunk can contribute at most
+            # k rows to the final top-k.
+            max_keep = max(1, int(k))
+            if len(top) > max_keep * 4:
+                top.sort(key=lambda item: (-item[0], item[1]))
+                del top[max_keep:]
+    except sqlite3.Error:
+        return []
+
+    if effective_cap is not None and truncated:
+        # The guarded scope is the owner-store candidate scope, not the
+        # caller's post-KNN filters: global for narrowing off, capped domain
+        # for narrowing on.
+        scope_rows = _scope_row_count(conn, owner_kind, None, ())
+        if scope_rows <= 0:
+            scope_rows = total + 1
+        excluded_rows = max(0, scope_rows - int(effective_cap))
+        if scope_rows > threshold and excluded_rows > 0:
+            _record_vec_scope_guard(
+                scope=scope_label or f"{owner_kind}:scope",
+                scope_rows=scope_rows,
+                threshold=threshold,
+                excluded_rows=excluded_rows,
+            )
+    if stats_out is not None:
+        stats_out["fetched"] = total
+
+    top.sort(key=lambda item: (-item[0], item[1]))
+    top = top[: max(0, int(k))]
+    if where_sql:
+        top = _filter_top_by_where(conn, joins, id_expr, top, where_sql, where_params)
+    results: List[Dict[str, Any]] = []
+    for sim, entity_rowid, entity_id in top[: max(0, int(k))]:
+        results.append(
+            {
+                "id": entity_id,
+                "rowid": entity_rowid,
+                # Legacy-clamped similarity: legacy-clamped similarity, matching the
+                # ENG-PROD arms (float32/int8 variants bound sim to [0, 1],
+                # truncating negative cosine to 0.0).  Selection and
+                # tie-break above still use raw cosine.
+                "sim": float(max(0.0, min(1.0, sim))),
+                "distance": math.sqrt(max(0.0, 2.0 - 2.0 * min(1.0, max(-1.0, sim)))),
+            }
+        )
+    return results
+
+def _owner_rowid_index(conn: sqlite3.Connection, table: str) -> Optional[str]:
+    """Name of the (owner_kind, owner_rowid) index form4 pins the join to.
+
+    Accepts the documented ``idx_<table>_owner_rowid`` name or any index over
+    exactly (owner_kind, owner_rowid) on the shard table (DDLs use
+    ``idx_vector_owner_rowid``).  Returns None when the DB has no such index;
+    the caller then falls back to a plain CROSS JOIN (same cap semantics, no
+    forced index).
+    """
+    expected = f"idx_{table}_owner_rowid"
+    try:
+        rows = conn.execute(
+            "SELECT name FROM sqlite_master WHERE type='index' AND tbl_name=?",
+            (table,),
+        ).fetchall()
+    except sqlite3.Error:
+        return None
+    names = [r[0] for r in rows]
+    if expected in names:
+        return expected
+    for name in names:
+        try:
+            cols = [r[2] for r in conn.execute(f"PRAGMA index_info({name})").fetchall()]
+        except sqlite3.Error:
+            continue
+        if cols == ["owner_kind", "owner_rowid"]:
+            return name
+    return None
+
+
+def working_orphan_owner_ids(conn: sqlite3.Connection) -> List[str]:
+    try:
+        rows = conn.execute(
+            "SELECT owner_id FROM v_vector_orphans WHERE owner_kind = 'working'"
+        ).fetchall()
+    except sqlite3.Error:
+        try:
+            rows = conn.execute(
+                "SELECT vs.owner_id FROM vector_store vs "
+                "LEFT JOIN working_memory wm ON wm.id = vs.owner_id "
+                "WHERE vs.owner_kind = 'working' AND vs.state = 'active' "
+                "AND wm.id IS NULL"
+            ).fetchall()
+        except sqlite3.Error:
+            return []
+    return [str(r[0]) for r in rows]
+
+
+# ---------------------------------------------------------------------------
+# Write path
+# ---------------------------------------------------------------------------
+
+def _owner_metadata(conn: sqlite3.Connection, owner_kind: str, owner_id: str) -> Optional[Dict[str, Any]]:
+    if owner_kind == "working":
+        try:
+            row = conn.execute(
+                "SELECT rowid, COALESCE(author_id,''), COALESCE(author_type,''), "
+                "COALESCE(channel_id,''), COALESCE(created_at,'') "
+                "FROM working_memory WHERE id = ?",
+                (owner_id,),
+            ).fetchone()
+        except sqlite3.Error:
+            return None
+    elif owner_kind == "episodic":
+        try:
+            row = conn.execute(
+                "SELECT rowid, COALESCE(author_id,''), COALESCE(author_type,''), "
+                "COALESCE(channel_id,''), COALESCE(created_at,'') "
+                "FROM episodic_memory WHERE id = ?",
+                (owner_id,),
+            ).fetchone()
+        except sqlite3.Error:
+            return None
+    elif owner_kind == "fact":
+        try:
+            row = conn.execute(
+                "SELECT rowid, '', '', '', COALESCE(created_at,'') FROM facts WHERE fact_id = ?",
+                (owner_id,),
+            ).fetchone()
+        except sqlite3.Error:
+            return None
+    else:
+        return None
+    if row is None:
+        return None
+    return {
+        "rowid": int(row[0]),
+        "author_id": str(row[1] or ""),
+        "author_type": str(row[2] or ""),
+        "channel_id": str(row[3] or ""),
+        "created_at": str(row[4] or ""),
+    }
+
+
+def upsert_vector(
+    conn: sqlite3.Connection,
+    *,
+    owner_kind: str,
+    owner_id: str,
+    embedding: Any,
+    owner_rowid: Optional[int] = None,
+    model: str = "",
+    author_id: str = "",
+    author_type: str = "",
+    channel_id: str = "",
+    bank: str = "",
+    commit: bool = True,
+) -> bool:
+    """Upsert one canonical float32 vector row into vector_store.
+
+    Returns True when the owner row exists and the BLOB was written.
+    ``owner_rowid`` may be supplied explicitly (useful for tests); otherwise
+    it is resolved from the owning content table and must exist.
+    """
+    if not vector_store_available(conn) or not owner_id:
+        return False
+    kind = str(owner_kind or "").lower()
+    if kind not in {"working", "episodic", "fact", "triple", "canonical"}:
+        return False
+    meta = _owner_metadata(conn, kind, owner_id)
+    if meta is None:
+        return False
+    rowid = int(owner_rowid) if owner_rowid is not None else meta["rowid"]
+    if rowid != meta["rowid"]:
+        # An explicit rowid that does not match the content row is an orphan
+        # by construction; the read path would never return it.
+        return False
+    vals = blob_to_floats(embedding)
+    raw = floats_to_blob(vals)
+    if not vals or not raw:
+        return False
+    dim = len(vals)
+    norm = math.sqrt(sum(float(x) * float(x) for x in vals))
+    content_hash = hashlib.sha256(raw).hexdigest()
+    author_id = str(author_id or meta["author_id"] or "")
+    author_type = str(author_type or meta["author_type"] or "")
+    channel_id = str(channel_id or meta["channel_id"] or "")
+    created_at = meta["created_at"] or None
+    try:
+        conn.execute(
+            """
+            INSERT INTO vector_store
+                (owner_kind, owner_id, owner_rowid, author_id, author_type,
+                 channel_id, bank, dim, vec_type, vector, model, norm, state,
+                 generation, content_hash, created_at, updated_at)
+            VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'float32', ?, ?, ?, 'active', 0, ?,
+                    COALESCE(?, CURRENT_TIMESTAMP), CURRENT_TIMESTAMP)
+            ON CONFLICT(owner_kind, owner_id) DO UPDATE SET
+                owner_rowid = excluded.owner_rowid,
+                author_id = excluded.author_id,
+                author_type = excluded.author_type,
+                channel_id = excluded.channel_id,
+                bank = excluded.bank,
+                dim = excluded.dim,
+                vec_type = 'float32',
+                vector = excluded.vector,
+                model = excluded.model,
+                norm = excluded.norm,
+                state = 'active',
+                generation = vector_store.generation + 1,
+                content_hash = excluded.content_hash,
+                updated_at = CURRENT_TIMESTAMP,
+                deleted_at = NULL
+            """,
+            (
+                kind,
+                owner_id,
+                rowid,
+                author_id,
+                author_type,
+                channel_id,
+                str(bank or ""),
+                dim,
+                sqlite3.Binary(raw),
+                str(model or ""),
+                norm,
+                content_hash,
+                created_at,
+            ),
+        )
+        if commit:
+            _commit(conn)
+        return True
+    except sqlite3.Error:
+        return False
+
+
+def upsert_working_vector(
+    conn: sqlite3.Connection,
+    memory_id: str,
+    embedding: Any,
+    *,
+    model: str = "",
+    commit: bool = True,
+) -> bool:
+    return upsert_vector(
+        conn, owner_kind="working", owner_id=memory_id, embedding=embedding,
+        model=model, commit=commit,
+    )
+
+
+def upsert_episodic_vector(
+    conn: sqlite3.Connection,
+    memory_id: str,
+    rowid: int,
+    embedding: Any,
+    *,
+    model: str = "",
+    commit: bool = True,
+) -> bool:
+    return upsert_vector(
+        conn, owner_kind="episodic", owner_id=memory_id, owner_rowid=rowid,
+        embedding=embedding, model=model, commit=commit,
+    )
+
+
+def soft_delete_vector(
+    conn: sqlite3.Connection,
+    *,
+    owner_kind: str,
+    owner_id: str,
+    commit: bool = False,
+) -> bool:
+    try:
+        cur = conn.execute(
+            "UPDATE vector_store SET state = 'deleted', "
+            "deleted_at = CURRENT_TIMESTAMP, "
+            "generation = generation + 1, "
+            "updated_at = CURRENT_TIMESTAMP "
+            "WHERE owner_kind = ? AND owner_id = ? AND state = 'active'",
+            (str(owner_kind), owner_id),
+        )
+        if commit:
+            _commit(conn)
+        return cur.rowcount > 0
+    except sqlite3.Error:
+        return False
+
+
+def soft_delete_working_vector(conn: sqlite3.Connection, memory_id: str, *, commit: bool = False) -> bool:
+    return soft_delete_vector(conn, owner_kind="working", owner_id=memory_id, commit=commit)
+
+
+def soft_delete_episodic_vector(conn: sqlite3.Connection, memory_id: str, *, commit: bool = False) -> bool:
+    return soft_delete_vector(conn, owner_kind="episodic", owner_id=memory_id, commit=commit)
