diff -ruN b/mnemosyne/core/recall_counters.py c/mnemosyne/core/recall_counters.py
--- b/mnemosyne/core/recall_counters.py	1970-01-01 08:00:00.000000000 +0800
+++ c/mnemosyne/core/recall_counters.py	2026-09-30 18:41:23.883561349 +0800
@@ -0,0 +1,181 @@
+"""Read-only in-engine recall counters .
+
+This module is *observation only*: it never alters recall behaviour, never
+writes to any database, and never raises into the recall path.  It records
+per-recall-call cap statistics produced by the r11 domain-cap candidate fetch
+(``_wm_vec_search_capped`` / ``core_schema.search_vector_store`` capped arm):
+
+  * ``candidates``     -- rows the capped candidate fetch delivered to the
+                          scorer for this recall call (== what an external
+                          statement spy sees delivered by that statement).
+  * ``truncated``      -- True only when rows were *actually* cut by the
+                          in-domain cap C (DOMAIN_CAP); false whenever the
+                          domain fit under the cap, including the exact-C
+                          boundary case (C rows present -> zero rows cut).
+  * ``truncated_rows`` -- number of rows the cap cut (= domain rows matching
+                          the recall filters minus C, clamped at 0).
+  * ``domain_rows``    -- matching in-domain rows under the recall filters
+                          (only probed when truncated; None otherwise).
+
+Consumers (read-only): the r14 domain-cap inspector / alerting hooks read the
+process counters via :func:`get_recall_counters` and the per-call marker via
+:func:`peek_cap_stats`; ``BeamMemory.recall`` publishes the marker into its
+result structure (additive fields, see r14 REPORT/VERIFY).
+
+Thread-safety: the per-call record is thread-local (one recall call per
+thread), the cumulative totals are guarded by a lock.
+"""
+
+from __future__ import annotations
+
+import threading
+from typing import Any, Dict, Optional
+
+# Additive per-result-row marker field names (item 3).  Existing result fields
+# are never renamed or repurposed; these keys are pure additions and always
+# present on recall result rows (false / 0 when nothing was cut).
+RESULT_FIELD_TRUNCATED = "cap_truncated"
+RESULT_FIELD_TRUNCATED_ROWS = "cap_truncated_rows"
+
+_local = threading.local()
+_lock = threading.Lock()
+_totals: Dict[str, int] = {
+    "recall_calls": 0,
+    "cap_fetches": 0,
+    "truncated_calls": 0,
+    "candidates_total": 0,
+    "truncated_rows_total": 0,
+    # r17 M2 scope guard: cumulative read-only counters.  The names are
+    # deliberately part of the public snapshot returned by
+    # get_recall_counters(); they never feed back into recall.
+    "vec_scope_truncated": 0,
+    "vec_scope_excluded_rows": 0,
+}
+
+
+def record_cap_fetch(
+    *,
+    cap: int,
+    candidates: int,
+    truncated: bool,
+    truncated_rows: int,
+    domain_rows: Optional[int] = None,
+) -> Dict[str, Any]:
+    """Record one capped candidate fetch (called from the recall path).
+
+    Returns the stored record.  Pure bookkeeping: no I/O, no behaviour change.
+    """
+    stats = {
+        "cap": int(cap),
+        "candidates": int(candidates),
+        "truncated": bool(truncated),
+        "truncated_rows": max(0, int(truncated_rows)),
+        "domain_rows": None if domain_rows is None else int(domain_rows),
+    }
+    _local.cap_stats = stats
+    with _lock:
+        _totals["cap_fetches"] += 1
+        if stats["truncated"]:
+            _totals["truncated_calls"] += 1
+        _totals["candidates_total"] += stats["candidates"]
+        _totals["truncated_rows_total"] += stats["truncated_rows"]
+    return stats
+
+
+def note_recall_call() -> None:
+    """Count one completed recall() call (totals only)."""
+    with _lock:
+        _totals["recall_calls"] += 1
+
+
+def reset_cap_stats() -> None:
+    """Start-of-call hygiene: drop any stale per-thread record."""
+    _local.cap_stats = None
+
+
+def peek_cap_stats() -> Optional[Dict[str, Any]]:
+    """Last cap record recorded by this thread (or None).  Read-only view."""
+    stats = getattr(_local, "cap_stats", None)
+    return None if stats is None else dict(stats)
+
+
+def consume_cap_stats() -> Optional[Dict[str, Any]]:
+    """Like peek_cap_stats() but clears the per-thread record."""
+    stats = peek_cap_stats()
+    _local.cap_stats = None
+    return stats
+
+
+def result_marker_fields(stats: Optional[Dict[str, Any]]) -> Dict[str, Any]:
+    """The additive per-result-row marker (item 3) for one recall call.
+
+    Always present, strictly false/0 when the cap cut zero rows (including
+    when the cap never ran at all).
+    """
+    s = stats or {}
+    return {
+        RESULT_FIELD_TRUNCATED: bool(s.get("truncated", False)),
+        RESULT_FIELD_TRUNCATED_ROWS: max(0, int(s.get("truncated_rows", 0) or 0)),
+    }
+
+
+def cap_summary(stats: Optional[Dict[str, Any]]) -> Dict[str, Any]:
+    """Machine-readable cap block for explain / MCP payloads (item 3)."""
+    s = stats or {}
+    return {
+        "cap": int(s.get("cap", 0) or 0),
+        "candidates": int(s.get("candidates", 0) or 0),
+        "truncated": bool(s.get("truncated", False)),
+        "truncated_rows": max(0, int(s.get("truncated_rows", 0) or 0)),
+        "domain_rows": None if s.get("domain_rows") is None else int(s["domain_rows"]),
+    }
+
+
+def record_vec_scope_truncation(
+    *,
+    scope: str,
+    scope_rows: int,
+    threshold: int,
+    excluded_rows: int,
+) -> Dict[str, Any]:
+    """Record one r17 M2 scope-guard truncation (read-only bookkeeping).
+
+    ``vec_scope_truncated`` is a cumulative count of candidate fetches that
+    actually truncated; ``vec_scope_excluded_rows`` is the cumulative number
+    of scoreable rows excluded by those truncations.  The last per-thread
+    record is available via :func:`peek_vec_scope_stats`.
+    """
+    stats = {
+        "scope": str(scope or ""),
+        "scope_rows": int(scope_rows),
+        "threshold": int(threshold),
+        "excluded_rows": max(0, int(excluded_rows)),
+        "truncated": True,
+    }
+    _local.vec_scope_stats = stats
+    with _lock:
+        _totals["vec_scope_truncated"] += 1
+        _totals["vec_scope_excluded_rows"] += stats["excluded_rows"]
+    return stats
+
+
+def reset_vec_scope_stats() -> None:
+    """Start-of-call hygiene for the per-thread r17 scope-guard record."""
+    _local.vec_scope_stats = None
+
+
+def peek_vec_scope_stats() -> Optional[Dict[str, Any]]:
+    """Last r17 scope-guard record recorded by this thread (or None)."""
+    stats = getattr(_local, "vec_scope_stats", None)
+    return None if stats is None else dict(stats)
+
+
+def get_recall_counters() -> Dict[str, Any]:
+    """Read-only snapshot of the cumulative counters + last per-call record."""
+    with _lock:
+        totals = dict(_totals)
+    return {
+        "totals": totals,
+        "last_cap": peek_cap_stats(),
+        "last_vec_scope": peek_vec_scope_stats(),
+    }
