--- b/mnemosyne/core/core_schema.py	1970-01-01 08:00:00.000000000 +0800
+++ c/mnemosyne/core/core_schema.py	2026-09-30 18:41:23.867460476 +0800
@@ -0,0 +1,886 @@
+"""B5 zero-footprint core-schema vector-store adapter.
+
+This module is intentionally dependency-light: it must import and run under
+the system Python 3 (no numpy, no sqlite-vec).  The ``MNEMOSYNE_CORE_SCHEMA``
+env switch only recognises ``1/true/yes/on`` (case-insensitive, trimmed);
+everything else keeps the legacy path.
+
+Read helpers query ``vector_store`` directly and join the owning content
+table, so orphan vectors (a vector_store row with no content-table owner)
+can never enter a KNN result.  The read candidate pool is exactly the old
+arm's global KNN restricted to the current scope: every scoreable row in
+that scope is evaluated; ``MNEMOSYNE_CORE_VECTOR_SCAN_LIMIT`` is now a cost
+threshold/guard, not a functional truncation window.  Write helpers upsert
+the canonical float32 BLOB in ``vector_store`` instead of writing the
+read-only compatibility view ``memory_embeddings``.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import math
+import os
+import re
+import sqlite3
+import struct
+from typing import Any, Dict, Iterable, List, Optional, Sequence, Tuple
+
+CORE_SCHEMA_ENV = "MNEMOSYNE_CORE_SCHEMA"
+_TRUTHY = frozenset({"1", "true", "yes", "on"})
+logger = logging.getLogger("mnemosyne.core.core_schema")
+
+
+def core_schema_enabled() -> bool:
+    """Return True only for the documented truthy values."""
+    return os.environ.get(CORE_SCHEMA_ENV, "").strip().lower() in _TRUTHY
+
+
+def _object_sql(conn: sqlite3.Connection, name: str) -> Optional[str]:
+    try:
+        row = conn.execute(
+            "SELECT sql FROM sqlite_master WHERE name = ? AND type IN ('table','view')",
+            (name,),
+        ).fetchone()
+    except sqlite3.Error:
+        return None
+    if row is None:
+        return None
+    return row[0]
+
+
+def table_exists(conn: sqlite3.Connection, name: str) -> bool:
+    return _object_sql(conn, name) is not None
+
+
+def vector_store_available(conn: sqlite3.Connection) -> bool:
+    """True when the DB has the b5 canonical vector_store table."""
+    try:
+        row = conn.execute(
+            "SELECT sql FROM sqlite_master WHERE type = 'table' AND name = 'vector_store'"
+        ).fetchone()
+    except sqlite3.Error:
+        return False
+    if not row or not row[0]:
+        return False
+    sql = str(row[0]).lower()
+    return "owner_kind" in sql and "vector" in sql and "owner_id" in sql
+
+
+_ACTIVE_PATH_LOGGED = False
+
+
+def core_vector_path_enabled(conn: sqlite3.Connection) -> bool:
+    """Switch ON *and* the target DB really is a new-core store.
+
+    Logs one process-lifetime line the first time the new-core read path is
+    selected; the c4 runbook uses this line to prove the opt-in took effect.
+    """
+    global _ACTIVE_PATH_LOGGED
+    enabled = core_schema_enabled() and vector_store_available(conn)
+    if enabled and not _ACTIVE_PATH_LOGGED:
+        _ACTIVE_PATH_LOGGED = True
+        logger.info(
+            "core_schema vector path active: candidate pool = old-arm global KNN "
+            "restricted to current scope; module=%s MNEMOSYNE_DOMAIN_NARROW=%s",
+            __file__, os.environ.get("MNEMOSYNE_DOMAIN_NARROW", ""),
+        )
+    return enabled
+
+
+def is_external_fts(conn: sqlite3.Connection, table: str) -> bool:
+    """True when ``table`` is an FTS5 external-content table without an id col.
+
+    The b5 ``fts_working`` has no ``id`` column: its rowid is the
+    ``working_memory.rowid`` foreign key.  The old schema's fts_working does
+    have ``id UNINDEXED``, so the two can be told apart from sqlite_master.
+    """
+    sql = _object_sql(conn, table)
+    if not sql or "fts5" not in str(sql).lower():
+        return False
+    if re.search(r"content\s*=\s*'([^']+)'", str(sql), re.IGNORECASE) is None:
+        return False
+    try:
+        cols = [str(r[1]) for r in conn.execute(f'PRAGMA table_info("{table}")').fetchall()]
+    except sqlite3.Error:
+        return False
+    return "id" not in cols
+
+
+# ---------------------------------------------------------------------------
+# float32 BLOB helpers (pure Python)
+# ---------------------------------------------------------------------------
+
+def blob_to_floats(raw: Any) -> List[float]:
+    """Decode a stored vector from float32 BLOB, legacy JSON, or sequence."""
+    if raw is None:
+        return []
+    if isinstance(raw, str):
+        try:
+            return [float(x) for x in json.loads(raw)]
+        except Exception:
+            return []
+    if isinstance(raw, memoryview):
+        b = raw.tobytes()
+    elif isinstance(raw, bytearray):
+        b = bytes(raw)
+    elif isinstance(raw, bytes):
+        b = raw
+    else:
+        # numpy array / list / tuple / array.array
+        tolist = getattr(raw, "tolist", None)
+        if callable(tolist):
+            try:
+                return [float(x) for x in tolist()]
+            except Exception:
+                return []
+        try:
+            return [float(x) for x in raw]
+        except Exception:
+            return []
+    if not b:
+        return []
+    if len(b) % 4 == 0:
+        try:
+            return list(struct.unpack("<%df" % (len(b) // 4), b))
+        except (struct.error, ValueError):
+            return []
+    # Possibly JSON bytes from a legacy writer.
+    try:
+        vals = json.loads(b.decode("utf-8"))
+        return [float(x) for x in vals]
+    except Exception:
+        return []
+
+
+def floats_to_blob(vec: Any) -> bytes:
+    vals = blob_to_floats(vec)
+    if not vals:
+        return b""
+    out = bytearray()
+    for x in vals:
+        out.extend(struct.pack("<f", float(x)))
+    return bytes(out)
+
+
+def normalize_floats(vec: Any) -> List[float]:
+    vals = blob_to_floats(vec)
+    if not vals:
+        return []
+    norm = math.sqrt(sum(float(x) * float(x) for x in vals))
+    if norm <= 0.0:
+        return []
+    return [float(x) / norm for x in vals]
+
+
+def _dot(a: Sequence[float], b: Sequence[float]) -> float:
+    total = 0.0
+    for x, y in zip(a, b):
+        total += float(x) * float(y)
+    return total
+
+
+def cosine_similarity(query_unit: Sequence[float], vector: Any) -> Optional[float]:
+    vals = blob_to_floats(vector)
+    if not vals or len(vals) != len(query_unit):
+        return None
+    norm = math.sqrt(sum(float(x) * float(x) for x in vals))
+    if norm <= 0.0:
+        return None
+    return float(_dot(query_unit, [float(x) / norm for x in vals]))
+
+
+def _commit(conn: sqlite3.Connection) -> None:
+    real = getattr(conn, "_real_commit", None)
+    if callable(real):
+        real()
+    else:
+        conn.commit()
+
+
