+@dataclass(frozen=True)
+class PolicyBundle:
+    schema_version: int = 1
+    recall: RecallPolicy = RecallPolicy()
+    conflict: ConflictPolicy = ConflictPolicy()
+    retention: RetentionPolicy = RetentionPolicy()
+    sync: SyncPolicy = SyncPolicy()
