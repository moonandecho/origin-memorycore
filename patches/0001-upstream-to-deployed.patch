--- a/mnemosyne/core/embeddings.py	2026-07-30 17:03:20.000000000 +0800
+++ b/mnemosyne/core/embeddings.py	2026-08-05 15:15:32.339254478 +0800
@@ -393,8 +393,32 @@
 
 
 def serialize(vec: np.ndarray) -> str:
-    """Serialize embedding to JSON string."""
-    return json.dumps(vec.tolist())
+    """Serialize embedding.
+
+    2026-08-05 BLOB 化: 返回 float32 二进制 BLOB (1024 dim = 4096 B),
+    替代原 JSON 文本 (~22KB, 5.5x 膨胀)。列名 embedding_json 保留兼容,
+    存储内容为 bytes。读取用 deserialize() 兼容旧 JSON 文本数据。
+    """
+    if vec is None:
+        return b""
+    arr = np.asarray(vec, dtype=np.float32)
+    return arr.tobytes()
+
+
+def deserialize(raw) -> np.ndarray:
+    """Deserialize embedding stored by serialize().
+
+    兼容两种格式:
+      - bytes / BLOB (2026-08-05 新格式): np.frombuffer
+      - str / JSON 文本 (旧格式): json.loads
+    """
+    if raw is None:
+        return None
+    if isinstance(raw, (bytes, bytearray, memoryview)):
+        return np.frombuffer(raw, dtype=np.float32)
+    if isinstance(raw, str):
+        return np.array(json.loads(raw), dtype=np.float32)
+    return np.asarray(raw, dtype=np.float32)
 
 
